# Database Configuration
# Choose ONE approach: either DATABASE_URL or individual vars

# Approach 1: PostgreSQL Connection URL (for production, platforms like Heroku)
DATABASE_URL=postgresql://user:password@localhost:5432/securetalk

# Approach 2: Individual PostgreSQL Configuration (for local development)
# Uncomment and fill in your local database credentials
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=your_password_here
# PG_DATABASE=securetalk

# SSL Configuration (optional, set to "true" if your database requires SSL)
PG_SSL=false

# JWT Secret for token signing (MUST change for production)
JWT_SECRET=your_super_secret_key_change_this_in_production

# Server Port (optional, defaults to 5000)
PORT=5000
